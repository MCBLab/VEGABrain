FROM rocker/tidyverse:4.5.1

# Install system dependencies required for ggseg and plumber
RUN apt-get update && apt-get install -y \
    libxml2-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libcairo2-dev \
    libudunits2-dev \
    libproj-dev \
    libgdal-dev \
    libgeos-dev \
    libsodium-dev \
    libmagick++-dev \
    cmake \
    libabsl-dev \
    && rm -rf /var/lib/apt/lists/*

ENV R_REPOS="https://packagemanager.posit.co/cran/__linux__/noble/latest"

# 3. Instalando library do R
RUN R -e "options(repos = c(CRAN = Sys.getenv('R_REPOS'))); \
    install.packages(c('devtools', 'plumber', 'remotes', 'sf', 'sp', 'maps', 'mapdata', \
    'maptools', 'rnaturalearth', 'rnaturalearthdata', 'ggrepel', 'svglite', \
    'vroom', 'msigdbr', 'cowplot'), Ncpus = 1);"

# 4. Instalando pacotes do Bioconductor (GSVA)
RUN R -e "options(repos = c(CRAN = Sys.getenv('R_REPOS'))); \
    if (!require('BiocManager', quietly = TRUE)) install.packages('BiocManager'); \
    BiocManager::install(c('GSVA', 'Biobase', 'GSEABase'), update = FALSE, ask = FALSE, Ncpus = 1)" \
    && R -e "stopifnot(requireNamespace('GSVA', quietly = TRUE), \
                        requireNamespace('Biobase', quietly = TRUE), \
                        requireNamespace('GSEABase', quietly = TRUE))"

# 5. Instalando o ggseg fixado na versão 2.1.1
RUN R -e "devtools::install_github('ggsegverse/ggseg.formats', ref = 'v0.0.2', upgrade = 'never')"
RUN R -e "devtools::install_github('ggsegverse/ggseg', ref = 'v2.1.1', upgrade = 'never')"

# Create directory for the API
RUN mkdir -p /api

WORKDIR /api

COPY genes_matrix_csv/ /api/genes_matrix_csv/
COPY mapeamento_regioes.csv /api/
COPY preparaDados.R /api/

RUN Rscript preparaDados.R

# limma, for the marker-based area test (stats/marker_stats.R). Installed after
# preparaDados.R on purpose: it changes nothing that script builds, and leaving
# the layers above untouched lets Docker reuse them (preparaDados.R is slow).
RUN R -e "options(repos = c(CRAN = Sys.getenv('R_REPOS'))); \
    BiocManager::install('limma', update = FALSE, ask = FALSE, Ncpus = 1)" \
    && R -e "stopifnot(requireNamespace('limma', quietly = TRUE))"

# Significance tests sourced by plumber.R: per area (score, markers) and per
# developmental stage. Nothing to precompute: rank tables and marker genes are
# built from dados_otimizados.rds on first use.
COPY stats/enrichment_stats.R stats/marker_stats.R stats/stage_stats.R /api/stats/

COPY plumber.R /api/

# Cloud Run injeta a porta via $PORT; 8080 e o default local
EXPOSE 8080

# Command to start the Plumber API
CMD ["R", "-e", "pr <- plumber::plumb('plumber.R'); pr$run(host = '0.0.0.0',  port=as.numeric(Sys.getenv('PORT', 8080)), docs = TRUE)"]
